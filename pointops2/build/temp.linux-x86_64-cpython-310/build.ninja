ninja_required_version = 1.3
cxx = /home/ssh555/miniconda/envs/hybrid-gs/bin/x86_64-conda-linux-gnu-c++
nvcc = /home/ssh555/miniconda/envs/hybrid-gs/bin/nvcc

cflags = -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/ssh555/miniconda/envs/hybrid-gs/include -I/home/ssh555/miniconda/envs/hybrid-gs/targets/x86_64-linux/include -L/home/ssh555/miniconda/envs/hybrid-gs/targets/x86_64-linux/lib -L/home/ssh555/miniconda/envs/hybrid-gs/targets/x86_64-linux/lib/stubs -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/ssh555/miniconda/envs/hybrid-gs/include -I/home/ssh555/miniconda/envs/hybrid-gs/targets/x86_64-linux/include -L/home/ssh555/miniconda/envs/hybrid-gs/targets/x86_64-linux/lib -L/home/ssh555/miniconda/envs/hybrid-gs/targets/x86_64-linux/lib/stubs -fPIC -I/home/ssh555/miniconda/envs/hybrid-gs/lib/python3.10/site-packages/torch/include -I/home/ssh555/miniconda/envs/hybrid-gs/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/ssh555/miniconda/envs/hybrid-gs/include -I/home/ssh555/miniconda/envs/hybrid-gs/include/python3.10 -c
post_cflags = -g -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=pointops2_cuda -std=c++17
cuda_cflags = -I/home/ssh555/miniconda/envs/hybrid-gs/lib/python3.10/site-packages/torch/include -I/home/ssh555/miniconda/envs/hybrid-gs/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/ssh555/miniconda/envs/hybrid-gs/include -I/home/ssh555/miniconda/envs/hybrid-gs/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O2 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=pointops2_cuda -gencode=arch=compute_90,code=compute_90 -gencode=arch=compute_90,code=sm_90 -ccbin /home/ssh555/miniconda/envs/hybrid-gs/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







