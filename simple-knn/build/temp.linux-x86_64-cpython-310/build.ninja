build /home/ssh555/BiShe/Code/Hybrid-GS/simple-knn/build/temp.linux-x86_64-cpython-310/simple_knn.o: cuda_compile /home/ssh555/BiShe/Code/Hybrid-GS/simple-knn/simple_knn.cu
build /home/ssh555/BiShe/Code/Hybrid-GS/simple-knn/build/temp.linux-x86_64-cpython-310/spatial.o: cuda_compile /home/ssh555/BiShe/Code/Hybrid-GS/simple-knn/spatial.cu








